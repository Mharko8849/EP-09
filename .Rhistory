ls()
library(tidyverse)
library(car)
library(leaps)
set.seed(5622)
datos <- read.csv2("EP09 Datos.csv")
datos_filtrados <- datos |>
filter(Gender == "0")
muestra <- datos_filtrados |> slice_sample(n = 100)
indices_entrenamiento <- sample(1:100, 70)
entrenamiento <- muestra[indices_entrenamiento, ]
prueba <- muestra[-indices_entrenamiento, ]
set.seed(5622)
variables_candidatas <- setdiff(colnames(datos), c("Weight", "Height", "Gender"))
predictores_azar <- sample(variables_candidatas, 8)
predictores_azar
otras_variables <- setdiff(variables_candidatas, predictores_azar)
correlaciones <- sapply(entrenamiento[otras_variables], function(x) cor(x, entrenamiento$Weight))
sort(correlaciones, decreasing = TRUE)
modelo_rls <- lm(Weight ~ Thigh.Girth, data = entrenamiento)
summary(modelo_rls)
paquetes <- c("boot", "car", "caret", "ggfortify", "ggplot2",
"ggpubr", "grid", "gridExtra", "gmodels", "ez", "emmeans", "infer",
"kableExtra", "Hmisc", "knitr", "leaps", "lmtest", "lsmeans",
"multcomp", "nlme", "plyr", "pROC", "purrr", "pwr", "readr",
"scatterplot3d", "psych", "TeachingDemos", "tibble", "tidyr","nortest", "dplyr", "MASS", "WRS2")
install_if_missing <- function(p) {
if (!require(p, character.only = TRUE)) {
install.packages(p, repos = "http://cran.us.r-project.org")
library(p, character.only = TRUE)
}
}
invisible(sapply(paquetes, install_if_missing))
library(conflicted)
conflicts_prefer(dplyr::select)
conflicts_prefer(dplyr::filter)
conflicts_prefer(dplyr::mutate)
conflicts_prefer(dplyr::pmap())
conflicts_prefer(dplyr::summarise())
set.seed(5622)
datos <- read.csv2("EP09 Datos.csv")
datos_filtrados <- datos |>
filter(Gender == "0")
muestra <- datos_filtrados |> slice_sample(n = 100)
indices_entrenamiento <- sample(1:100, 70)
entrenamiento <- muestra[indices_entrenamiento, ]
prueba <- muestra[-indices_entrenamiento, ]
set.seed(5622)
variables_candidatas <- setdiff(colnames(datos), c("Weight", "Height", "Gender"))
predictores_azar <- sample(variables_candidatas, 8)
predictores_azar
otras_variables <- setdiff(variables_candidatas, predictores_azar)
correlaciones <- sapply(entrenamiento[otras_variables], function(x) cor(x, entrenamiento$Weight))
sort(correlaciones, decreasing = TRUE)
modelo_rls <- lm(Weight ~ Thigh.Girth, data = entrenamiento)
summary(modelo_rls)
predictores_azar
# Matriz de correlaciones entre los predictores sorteados (para detectar colinealidad previa)
round(cor(entrenamiento[predictores_azar]), 2)
modelo_completo <- lm(Weight ~ Thigh.Girth + Biiliac.diameter + Knees.diameter + Chest.depth +
Bitrochanteric.diameter + Chest.Girth + Ankles.diameter +
Chest.diameter + Waist.Girth, data = entrenamiento)
modelo_rlm <- step(modelo_rls,
scope = list(lower = modelo_rls, upper = modelo_completo),
direction = "both", trace = 1)
summary(modelo_rlm)
variables_totales <- c("Thigh.Girth", predictores_azar)
modelo_regsubsets <- regsubsets(Weight ~ ., data = entrenamiento[, c("Weight", variables_totales)],
method = "exhaustive",
nvmax = 6,          # Thigh.Girth + hasta 5 predictores adicionales
force.in = "Thigh.Girth")
resumen_regsubsets <- summary(modelo_regsubsets)
resumen_regsubsets$outmat
data.frame(n_predictores = 1:6,
adjR2 = resumen_regsubsets$adjr2,
BIC = resumen_regsubsets$bic,
Cp = resumen_regsubsets$cp)
length(resumen_regsubsets$adjr2)
data.frame(n_predictores = 2:6,
adjR2 = resumen_regsubsets$adjr2,
BIC = resumen_regsubsets$bic,
Cp = resumen_regsubsets$cp)
modelo_rlm <- lm(Weight ~ Thigh.Girth + Biiliac.diameter + Knees.diameter + Ankles.diameter + Waist.Girth,
data = entrenamiento)
summary(modelo_rlm)
vif(modelo_rlm)
# Condiciones de la RLM sobre el modelo del punto 6
cat("== Independencia de residuos (Durbin-Watson) ==\n")
print(durbinWatsonTest(modelo_rlm))
cat("\n== Normalidad de residuos (Shapiro-Wilk) ==\n")
print(shapiro.test(resid(modelo_rlm)))
cat("\n== Homocedasticidad (Breusch-Pagan) ==\n")
print(ncvTest(modelo_rlm))
cat("\n== Multicolinealidad (VIF) ==\n")
print(vif(modelo_rlm))
cat("VIF promedio:", mean(vif(modelo_rlm)), "\n")
# Casos atípicos e influyentes
n <- nrow(entrenamiento)
k <- length(coef(modelo_rlm)) - 1
# Umbrales de referencia
umbral_cook <- 4 / n
umbral_lev  <- 2 * (k + 1) / n
infl <- data.frame(
obs        = 1:n,
resid_std  = rstandard(modelo_rlm),
cook       = cooks.distance(modelo_rlm),
leverage   = hatvalues(modelo_rlm)
)
cat("Umbral distancia de Cook (4/n):", round(umbral_cook, 4), "\n")
cat("Umbral apalancamiento (2(k+1)/n):", round(umbral_lev, 4), "\n\n")
cat("== Residuos estandarizados |>| 3 ==\n")
print(infl[abs(infl$resid_std) > 3, ])
cat("\n== Casos con Cook > 4/n ==\n")
print(infl[infl$cook > umbral_cook, ])
cat("\n== Casos con alto apalancamiento ==\n")
print(infl[infl$leverage > umbral_lev, ])
cat("\nMáxima distancia de Cook:", round(max(infl$cook), 3), "\n")
# Refit sin el caso con mayor distancia de Cook (obs 66, fila 80)
fila_influyente <- which(rownames(entrenamiento) == "80")
entrenamiento_sin <- entrenamiento[-fila_influyente, ]
modelo_rlm_sin <- lm(Weight ~ Thigh.Girth + Biiliac.diameter + Knees.diameter + Ankles.diameter + Waist.Girth,
data = entrenamiento_sin)
cat("== Homocedasticidad tras excluir caso influyente ==\n")
print(ncvTest(modelo_rlm_sin))
cat("\n== Normalidad ==\n")
print(shapiro.test(resid(modelo_rlm_sin))$p.value)
cat("\nR2 ajustado original:", summary(modelo_rlm)$adj.r.squared,
"| sin caso:", summary(modelo_rlm_sin)$adj.r.squared, "\n")
library(lmtest)
cat("== Breusch-Pagan estudentizado (lmtest, contra todos los predictores) ==\n")
print(bptest(modelo_rlm))
# Gráficos de diagnóstico
autoplot(modelo_rlm, which = 1:4) + theme_minimal()
# Box-Cox para encontrar la transformación adecuada de la respuesta
bc <- boxcox(modelo_rlm, lambda = seq(-2, 2, 0.1), plotit = FALSE)
lambda_opt <- bc$x[which.max(bc$y)]
cat("Lambda óptimo Box-Cox:", round(lambda_opt, 3), "\n\n")
# Lambda cercano a 0 -> transformación logarítmica
modelo_rlm_log <- lm(log(Weight) ~ Thigh.Girth + Biiliac.diameter + Knees.diameter + Ankles.diameter + Waist.Girth,
data = entrenamiento)
cat("== Homocedasticidad (BP) modelo log ==\n")
print(ncvTest(modelo_rlm_log))
cat("\n== Normalidad (Shapiro) modelo log ==\n")
print(shapiro.test(resid(modelo_rlm_log))$p.value)
cat("\n== Independencia (DW) modelo log ==\n")
print(durbinWatsonTest(modelo_rlm_log)$p)
cat("\n== VIF ==\n"); print(vif(modelo_rlm_log))
cat("\nR2 ajustado modelo log:", summary(modelo_rlm_log)$adj.r.squared, "\n")
cat("Máx distancia de Cook:", round(max(cooks.distance(modelo_rlm_log)), 3), "\n")
