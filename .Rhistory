set.seed(19)
print(durbinWatsonTest(modelo_rlm)); print(ncvTest(modelo_rlm))
print(shapiro.test(resid(modelo_rlm)))
cat("\nFactores de inflación de la varianza:\n"); print(round(vif(modelo_rlm), 3))
cat("Estadísticos de tolerancia:\n"); print(round(1 / vif(modelo_rlm), 3))
cat("\nCasos por predictor:", round(nrow(entrenamiento) /
(length(coef(modelo_rlm)) - 1), 1), "\n")
# ARREGLO 1: se elimina el único caso con influencia problemática del modelo de RLS.
# Como advierte la sección 13.5.3, la decisión se basa en el análisis riguroso
# anterior y no en un descarte arbitrario de valores atípicos.
caso_influyente <- which.max(cooks.distance(modelo_rls))
entrenamiento_limpio <- entrenamiento[-caso_influyente, ]
modelo_rls_final <- lm(Weight ~ Thigh.Girth, data = entrenamiento_limpio)
print(summary(modelo_rls_final))
cat("Re-verificación de las condiciones del RLS:\n")
residualPlots(modelo_rls_final, type = "rstandard", col = "steelblue2",
pch = 20, col.quad = "steelblue4")
set.seed(19)  # durbinWatsonTest obtiene el valor p mediante bootstrapping
print(durbinWatsonTest(modelo_rls_final))
print(ncvTest(modelo_rls_final))
print(shapiro.test(resid(modelo_rls_final)))
cat("Máxima distancia de Cook:", round(max(cooks.distance(modelo_rls_final)), 3), "\n")
# Comparar el modelo nulo, el de RLS y el de RLM, que son jerárquicos, mediante la
# prueba de bondad de ajuste basada en la reducción de la varianza no explicada.
modelo_nulo <- lm(Weight ~ 1, data = entrenamiento)
cat("Prueba de bondad de ajuste:\n")
cat("---------------------------\n")
print(anova(modelo_nulo, modelo_rls, modelo_rlm))
# Desplegar gráficos de influencia de ambos modelos
casos_influyentes_rls <- influencePlot(modelo_rls, id = list(cex = 0.7))
cat("\nCasos que podrían ser influyentes (RLS):\n")
print(round(casos_influyentes_rls, 3))
cat("Umbral para la distancia de Cook:", round(qf(0.5, 2, 68), 3), "\n")
casos_influyentes_rlm <- influencePlot(modelo_rlm, id = list(cex = 0.7))
cat("\nCasos que podrían ser influyentes (RLM):\n")
print(round(casos_influyentes_rlm, 3))
cat("Umbral para la distancia de Cook:", round(qf(0.5, 6, 64), 3), "\n")
# Condiciones del modelo de RLS
cat("== Modelo de RLS ==\n")
cat("Pruebas de curvatura:\n")
residualPlots(modelo_rls, type = "rstandard",
id = list(method = "r", n = 3, cex = 0.7, location = "lr"),
col = "steelblue2", pch = 20, col.quad = "steelblue4")
marginalModelPlots(modelo_rls, sd = TRUE,
id = list(method = "r", n = 3, cex = 0.7, location = "lr"),
col = "steelblue", pch = 20, col.line = c("steelblue", "red"))
set.seed(19)
cat("\nPrueba de independencia:\n"); print(durbinWatsonTest(modelo_rls))
cat("\nPrueba de homocedasticidad:\n"); print(ncvTest(modelo_rls))
# Condiciones del modelo de RLM
cat("\n== Modelo de RLM ==\n")
cat("Pruebas de curvatura:\n")
residualPlots(modelo_rlm, type = "rstandard", col = "steelblue2",
pch = 20, col.quad = "steelblue4")
marginalModelPlots(modelo_rlm, sd = TRUE, col = "steelblue", pch = 20,
col.line = c("steelblue", "red"))
set.seed(19)
cat("\nPrueba de independencia:\n"); print(durbinWatsonTest(modelo_rlm))
cat("\nPrueba de homocedasticidad:\n"); print(ncvTest(modelo_rlm))
cat("\nFactores de inflación de la varianza:\n"); print(round(vif(modelo_rlm), 3))
cat("Estadísticos de tolerancia:\n"); print(round(1 / vif(modelo_rlm), 3))
# Bondad de ajuste: comparar los modelos jerárquicos obtenidos
modelo_nulo <- lm(Weight ~ 1, data = entrenamiento)
print(anova(modelo_nulo, modelo_rls, modelo_rlm))
# Condiciones del modelo de RLS
set.seed(19)  # durbinWatsonTest usa bootstrapping
print(durbinWatsonTest(modelo_rls))
print(ncvTest(modelo_rls))
print(shapiro.test(resid(modelo_rls)))
cat("Máxima distancia de Cook:", round(max(cooks.distance(modelo_rls)), 3),
" | Umbral:", round(qf(0.5, 2, 68), 3), "\n")
autoplot(modelo_rls, which = 1:4) + theme_minimal()
# Bondad de ajuste: comparar los modelos jerárquicos obtenidos
modelo_nulo <- lm(Weight ~ 1, data = entrenamiento)
print(anova(modelo_nulo, modelo_rls, modelo_rlm))
# Condiciones del modelo de RLS
set.seed(19)  # durbinWatsonTest usa bootstrapping
print(durbinWatsonTest(modelo_rls))
print(ncvTest(modelo_rls))
print(shapiro.test(resid(modelo_rls)))
cat("Máxima distancia de Cook:", round(max(cooks.distance(modelo_rls)), 3),
" | Umbral:", round(qf(0.5, 2, 68), 3), "\n")
autoplot(modelo_rls, which = 1:4) + theme_minimal()
# ARREGLO: se elimina el único caso con influencia problemática. La decisión se basa
# en el análisis anterior y no en un descarte arbitrario de valores atípicos.
entrenamiento_limpio <- entrenamiento[rownames(entrenamiento) != "80", ]
modelo_rls_final <- lm(Weight ~ Thigh.Girth, data = entrenamiento_limpio)
print(summary(modelo_rls_final))
set.seed(19)
print(durbinWatsonTest(modelo_rls_final))
print(ncvTest(modelo_rls_final))
print(shapiro.test(resid(modelo_rls_final)))
cat("Máxima distancia de Cook:", round(max(cooks.distance(modelo_rls_final)), 3), "\n")
# Calcular el error cuadrático medio de cada modelo en entrenamiento y en los 30 casos
# no vistos, siguiendo la validación cruzada simple de la sección 13.6.2.
rmse_rls_ent <- sqrt(mean(resid(modelo_rls_final)^2))
rmse_rlm_ent <- sqrt(mean(resid(modelo_rlm_final)^2))
# Se reajusta el RLM sin el caso influyente y se evalúa si todos sus predictores siguen aportando al ajuste.
modelo_rlm_limpio <- lm(fmla_mejor_bic, data = entrenamiento_limpio)
modelo_rlm_final <- update(modelo_rlm_limpio, . ~ . - Wrists.diameter)
print(anova(modelo_rlm_final, modelo_rlm_limpio))
print(summary(modelo_rlm_final))
set.seed(19)
print(durbinWatsonTest(modelo_rlm_final))
print(ncvTest(modelo_rlm_final))
print(shapiro.test(resid(modelo_rlm_final)))
cat("\nFactores de inflación de la varianza:\n"); print(round(vif(modelo_rlm_final), 3))
cat("Máxima distancia de Cook:", round(max(cooks.distance(modelo_rlm_final)), 3),
" | Umbral:", round(qf(0.5, 5, 64), 3), "\n")
autoplot(modelo_rlm_final, which = 1:4) + theme_minimal()
# Calcular el error cuadrático medio de cada modelo en entrenamiento y en los 30 casos
# no vistos, siguiendo la validación cruzada simple de la sección 13.6.2.
rmse_rls_ent <- sqrt(mean(resid(modelo_rls_final)^2))
rmse_rlm_ent <- sqrt(mean(resid(modelo_rlm_final)^2))
error_rls <- prueba[["Weight"]] - predict(modelo_rls_final, prueba)
error_rlm <- prueba[["Weight"]] - predict(modelo_rlm_final, prueba)
rmse_rls_pru <- sqrt(mean(error_rls^2))
rmse_rlm_pru <- sqrt(mean(error_rlm^2))
cat("Modelo de RLS - RMSE entrenamiento:", round(rmse_rls_ent, 3),
" | RMSE prueba:", round(rmse_rls_pru, 3), "\n")
cat("Modelo de RLM - RMSE entrenamiento:", round(rmse_rlm_ent, 3),
" | RMSE prueba:", round(rmse_rlm_pru, 3), "\n\n")
cat("Aumento del error en datos no vistos (RLS):",
round(100 * (rmse_rls_pru / rmse_rls_ent - 1), 1), "%\n")
cat("Aumento del error en datos no vistos (RLM):",
round(100 * (rmse_rlm_pru / rmse_rlm_ent - 1), 1), "%\n")
