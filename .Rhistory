predictores_azar
# Matriz de correlaciones entre los predictores sorteados (para detectar colinealidad previa)
round(cor(entrenamiento[predictores_azar]), 2)
modelo_completo <- lm(Weight ~ Thigh.Girth + Biiliac.diameter + Knees.diameter + Chest.depth +
Bitrochanteric.diameter + Chest.Girth + Ankles.diameter +
Chest.diameter + Waist.Girth, data = entrenamiento)
modelo_rlm <- step(modelo_rls,
scope = list(lower = modelo_rls, upper = modelo_completo),
direction = "both", trace = 1)
summary(modelo_rlm)
variables_totales <- c("Thigh.Girth", predictores_azar)
modelo_regsubsets <- regsubsets(Weight ~ ., data = entrenamiento[, c("Weight", variables_totales)],
method = "exhaustive",
nvmax = 6,          # Thigh.Girth + hasta 5 predictores adicionales
force.in = "Thigh.Girth")
resumen_regsubsets <- summary(modelo_regsubsets)
resumen_regsubsets$outmat
data.frame(n_predictores = 1:6,
adjR2 = resumen_regsubsets$adjr2,
BIC = resumen_regsubsets$bic,
Cp = resumen_regsubsets$cp)
length(resumen_regsubsets$adjr2)
data.frame(n_predictores = 2:6,
adjR2 = resumen_regsubsets$adjr2,
BIC = resumen_regsubsets$bic,
Cp = resumen_regsubsets$cp)
modelo_rlm <- lm(Weight ~ Thigh.Girth + Biiliac.diameter + Knees.diameter + Ankles.diameter + Waist.Girth,
data = entrenamiento)
summary(modelo_rlm)
vif(modelo_rlm)
# Condiciones de la RLM sobre el modelo del punto 6
cat("== Independencia de residuos (Durbin-Watson) ==\n")
print(durbinWatsonTest(modelo_rlm))
cat("\n== Normalidad de residuos (Shapiro-Wilk) ==\n")
print(shapiro.test(resid(modelo_rlm)))
cat("\n== Homocedasticidad (Breusch-Pagan) ==\n")
print(ncvTest(modelo_rlm))
cat("\n== Multicolinealidad (VIF) ==\n")
print(vif(modelo_rlm))
cat("VIF promedio:", mean(vif(modelo_rlm)), "\n")
# Casos atípicos e influyentes
n <- nrow(entrenamiento)
k <- length(coef(modelo_rlm)) - 1
# Umbrales de referencia
umbral_cook <- 4 / n
umbral_lev  <- 2 * (k + 1) / n
infl <- data.frame(
obs        = 1:n,
resid_std  = rstandard(modelo_rlm),
cook       = cooks.distance(modelo_rlm),
leverage   = hatvalues(modelo_rlm)
)
cat("Umbral distancia de Cook (4/n):", round(umbral_cook, 4), "\n")
cat("Umbral apalancamiento (2(k+1)/n):", round(umbral_lev, 4), "\n\n")
cat("== Residuos estandarizados |>| 3 ==\n")
print(infl[abs(infl$resid_std) > 3, ])
cat("\n== Casos con Cook > 4/n ==\n")
print(infl[infl$cook > umbral_cook, ])
cat("\n== Casos con alto apalancamiento ==\n")
print(infl[infl$leverage > umbral_lev, ])
cat("\nMáxima distancia de Cook:", round(max(infl$cook), 3), "\n")
# Refit sin el caso con mayor distancia de Cook (obs 66, fila 80)
fila_influyente <- which(rownames(entrenamiento) == "80")
entrenamiento_sin <- entrenamiento[-fila_influyente, ]
modelo_rlm_sin <- lm(Weight ~ Thigh.Girth + Biiliac.diameter + Knees.diameter + Ankles.diameter + Waist.Girth,
data = entrenamiento_sin)
cat("== Homocedasticidad tras excluir caso influyente ==\n")
print(ncvTest(modelo_rlm_sin))
cat("\n== Normalidad ==\n")
print(shapiro.test(resid(modelo_rlm_sin))$p.value)
cat("\nR2 ajustado original:", summary(modelo_rlm)$adj.r.squared,
"| sin caso:", summary(modelo_rlm_sin)$adj.r.squared, "\n")
library(lmtest)
cat("== Breusch-Pagan estudentizado (lmtest, contra todos los predictores) ==\n")
print(bptest(modelo_rlm))
# Gráficos de diagnóstico
autoplot(modelo_rlm, which = 1:4) + theme_minimal()
# Box-Cox para encontrar la transformación adecuada de la respuesta
bc <- boxcox(modelo_rlm, lambda = seq(-2, 2, 0.1), plotit = FALSE)
lambda_opt <- bc$x[which.max(bc$y)]
cat("Lambda óptimo Box-Cox:", round(lambda_opt, 3), "\n\n")
# Lambda cercano a 0 -> transformación logarítmica
modelo_rlm_log <- lm(log(Weight) ~ Thigh.Girth + Biiliac.diameter + Knees.diameter + Ankles.diameter + Waist.Girth,
data = entrenamiento)
cat("== Homocedasticidad (BP) modelo log ==\n")
print(ncvTest(modelo_rlm_log))
cat("\n== Normalidad (Shapiro) modelo log ==\n")
print(shapiro.test(resid(modelo_rlm_log))$p.value)
cat("\n== Independencia (DW) modelo log ==\n")
print(durbinWatsonTest(modelo_rlm_log)$p)
cat("\n== VIF ==\n"); print(vif(modelo_rlm_log))
cat("\nR2 ajustado modelo log:", summary(modelo_rlm_log)$adj.r.squared, "\n")
cat("Máx distancia de Cook:", round(max(cooks.distance(modelo_rlm_log)), 3), "\n")
install.packages("ggfortify")
install.packages("gmodels")
knitr::opts_chunk$set(echo = TRUE, warning = FALSE, message = FALSE)
library(dplyr)
library(ggplot2)
library(ggpubr)
library(car)
library(leaps)
library(ggfortify)
# Los últimos 4 números de RUT del integrante de menor edad en el equipo es 5622, por lo que se define la semilla 5622
set.seed(5622)
datos <- read.csv2("EP09 Datos.csv")
datos_filtrados <- datos |>
filter(Gender == "0")
muestra <- datos_filtrados |> slice_sample(n = 100)
# Separamos los 70 casos para construir el modelo y 30 para evaluarlo
indices_entrenamiento <- sample(1:100, 70)
entrenamiento <- muestra[indices_entrenamiento, ]
prueba <- muestra[-indices_entrenamiento, ]
cat("Observaciones postfiltrado:", nrow(muestra), "\n")
cat("Entrenamiento:", nrow(entrenamiento), " | Prueba:", nrow(prueba), "\n")
# Variables candidatas: se excluyen Peso (respuesta), Estatura (excluida por enunciado) y Género (constante dentro de la muestra, ya que se trabaja con un solo sexo)
variables_candidatas <- setdiff(colnames(datos), c("Weight", "Height", "Gender"))
predictores_azar <- sample(variables_candidatas, 8)
predictores_azar
# Variables restantes (ni sorteadas, ni excluidas por enunciado)
otras_variables <- setdiff(variables_candidatas, predictores_azar)
otras_variables
# Evaluamos correlación de cada una con Weight en el set de entrenamiento
correlaciones <- sapply(entrenamiento[otras_variables], function(x) cor(x, entrenamiento$Weight))
sort(correlaciones, decreasing = TRUE)
modelo_rls <- lm(Weight ~ Thigh.Girth, data = entrenamiento)
summary(modelo_rls)
# Gráfico de dispersión con la recta de regresión ajustada
ggplot(entrenamiento, aes(x = Thigh.Girth, y = Weight)) +
geom_point() +
geom_smooth(method = "lm", se = TRUE, color = "steelblue") +
labs(title = "Relación entre Weight y Thigh.Girth",
x = "Grosor promedio de muslos (cm)",
y = "Peso (kg)") +
theme_minimal()
# Solo se pueden usar las 8 variables sorteadas en el paso 3, más Thigh.Girth (paso 5).
variables_totales <- c("Thigh.Girth", predictores_azar)
print(variables_totales)
# Se revisa la matriz de correlaciones para anticipar posibles problemas de colinealidad.
print(round(cor(entrenamiento[variables_totales]), 2))
# Solo se pueden usar las 8 variables sorteadas en el paso 3, más Thigh.Girth (paso 5).
variables_totales <- c("Thigh.Girth", predictores_azar)
print(variables_totales)
# Primero revisamos la correlación entre los 8 predictores sorteados en el punto 3
# para tener presente posibles problemas de colinealidad al combinarlos.
round(cor(entrenamiento[predictores_azar]), 2)
# Solo se pueden usar las 8 variables sorteadas en el paso 3, más Thigh.Girth (paso 5).
variables_totales <- c("Thigh.Girth", predictores_azar)
print(variables_totales)
# Se revisa la matriz de correlaciones para anticipar posibles problemas de colinealidad.
print(round(cor(entrenamiento[variables_totales]), 2))
# Solo se pueden usar las 8 variables sorteadas en el paso 3, más Thigh.Girth (paso 5).
variables_totales <- c("Thigh.Girth", predictores_azar)
# Revisar las correlaciones entre los potenciales predictores para anticipar
# posibles problemas de multicolinealidad (condición 8 de la sección 14.5).
cat("Matriz de correlación entre los potenciales predictores:\n")
print(round(cor(entrenamiento[variables_totales]), 3))
# Solo se pueden usar las 8 variables sorteadas en el paso 3, más Thigh.Girth (paso 5).
variables_totales <- c("Thigh.Girth", predictores_azar)
# Revisar las correlaciones entre los potenciales predictores para anticipar
# posibles problemas de multicolinealidad (condición 8 de la sección 14.5).
cat("Matriz de correlación entre los potenciales predictores:\n")
print(round(cor(entrenamiento[variables_totales]), 3))
# Ajustar el modelo completo, que solo considera las variables sorteadas al azar.
fmla_completo <- as.formula(paste("Weight ~", paste(variables_totales, collapse = " + ")))
completo <- lm(fmla_completo, data = entrenamiento)
# Realizar regresión escalonada usando el menor BIC como criterio (aunque se reporta
# como AIC), bajando (temporalmente) el número de cifras significativas y el ancho
# máximo de las líneas al imprimir.
# El límite inferior es el modelo de RLS del paso 5, de modo que Thigh.Girth siempre
# permanece en el modelo, y el límite superior solo admite las variables sorteadas.
opt <- options(digits = 3, width = 70)
modelo_escalonado <- step(modelo_rls, scope = list(lower = modelo_rls, upper = completo),
direction = "both", k = log(nrow(entrenamiento)),
test = "F", trace = 1)
options(digits = opt[[1]], width = opt[[2]])
cat("\nModelo obtenido con regresión escalonada:\n")
cat("----------------------------------------\n")
print(formula(modelo_escalonado))
# Ajustar el modelo completo, que solo considera las variables sorteadas al azar.
fmla_completo <- as.formula(paste("Weight ~", paste(variables_totales, collapse = " + ")))
completo <- lm(fmla_completo, data = entrenamiento)
# Realizar regresión escalonada usando el menor BIC como criterio (aunque se reporta
# como AIC), bajando (temporalmente) el número de cifras significativas y el ancho
# máximo de las líneas al imprimir.
# El límite inferior es el modelo de RLS del paso 5, de modo que Thigh.Girth siempre
# permanece en el modelo, y el límite superior solo admite las variables sorteadas.
opt <- options(digits = 3, width = 70)
modelo_escalonado <- step(modelo_rls, scope = list(lower = modelo_rls, upper = completo),
direction = "both", k = log(nrow(entrenamiento)),
test = "F", trace = 1)
options(digits = opt[[1]], width = opt[[2]])
cat("\nModelo obtenido con regresión escalonada:\n")
cat("----------------------------------------\n")
print(formula(modelo_escalonado))
# Solo se pueden usar las 8 variables sorteadas en el paso 3, más Thigh.Girth (paso 5).
variables_totales <- c("Thigh.Girth", predictores_azar)
fmla_completo <- as.formula(paste("Weight ~", paste(variables_totales, collapse = " + ")))
# Revisar las correlaciones entre los potenciales predictores para anticipar
# posibles problemas de multicolinealidad (condición 8 de la sección 14.5).
print(round(cor(entrenamiento[variables_totales]), 3))
# Evaluar todas las combinaciones, forzando la permanencia de Thigh.Girth y permitiendo
# agregar hasta cinco predictores adicionales, como pide el enunciado.
combinaciones <- regsubsets(fmla_completo, data = entrenamiento, nbest = 1, nvmax = 6,
force.in = "Thigh.Girth", method = "exhaustive")
# Cada fila es el mejor subconjunto de cada tamaño; las mejores combinaciones
# aparecen en la parte superior de la matriz.
plot(combinaciones)
# Extraer el mejor subconjunto según BIC y verificar que coincida con el que maximiza
# el R2 ajustado.
resumen_combinaciones <- summary(combinaciones)
i_bic_minimo <- which.min(resumen_combinaciones[["bic"]])
i_r2a_maximo <- which.max(resumen_combinaciones[["adjr2"]])
mejor_comb_bic <- resumen_combinaciones[["which"]][i_bic_minimo, ]
comb_mejor_bic <- names(mejor_comb_bic[mejor_comb_bic == TRUE])[-1]
cat("¿BIC y R2 ajustado eligen el mismo modelo?", i_bic_minimo == i_r2a_maximo, "\n")
print(comb_mejor_bic)
# Construir el modelo de RLM con los predictores seleccionados
fmla_mejor_bic <- as.formula(paste("Weight", paste(comb_mejor_bic, collapse = " + "),
sep = " ~ "))
modelo_rlm <- lm(fmla_mejor_bic, data = entrenamiento)
print(summary(modelo_rlm))
