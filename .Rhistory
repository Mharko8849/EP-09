casos_influyentes <- influencePlot(modelo_rls, id = list(cex = 0.7))
cat("\nCasos que podrían ser influyentes:\n")
print(round(casos_influyentes, 3))
cat("\nUmbral para la distancia de Cook:", round(qf(0.5, 2, 68), 3), "\n")
